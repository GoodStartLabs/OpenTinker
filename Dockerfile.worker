# OpenTinker GPU Training Worker
# Based on NVIDIA PyTorch image with CUDA 12.8, PyTorch, and vLLM
# Runs Celery worker that executes training directly on H100 GPUs
#
# BUILD:
#   cd ~/GSL/OpenTinker
#   docker build -f Dockerfile.worker -t worker .

FROM nvcr.io/nvidia/pytorch:25.03-py3

LABEL maintainer="OpenTinker Community"
LABEL description="GPU-enabled Celery worker for OpenTinker training on H100 GPUs"

# Environment variables for vLLM and CUDA
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn \
    VLLM_USE_V1=1 \
    VLLM_DEVICE_MEM_ALLOCATOR=cuda \
    DEBIAN_FRONTEND=noninteractive \
    PIP_ROOT_USER_ACTION=ignore \
    HF_HUB_ENABLE_HF_TRANSFER="1" \
    CUDA_HOME=/usr/local/cuda

# Set working directory
WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        wget \
        curl \
        build-essential && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip and disable constraints from NVIDIA base image
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Upgrade pyarrow for datasets compatibility
RUN PIP_CONSTRAINT="" pip install --no-cache-dir "pyarrow==21.0.0"

# Install core OpenTinker dependencies
# Note: transformers 5.0.0 removed AutoModelForVision2Seq, need 4.47.x
RUN PIP_CONSTRAINT="" pip install --no-cache-dir \
    "transformers>=4.45.0,<5.0.0" \
    "datasets>=4.1.0" \
    "ray[default]>=2.9.0" \
    "fastapi>=0.104.0" \
    "uvicorn>=0.24.0" \
    "requests>=2.31.0" \
    "omegaconf>=2.3.0" \
    "hydra-core>=1.3.0"

# Install vLLM for inference
RUN PIP_CONSTRAINT="" pip install --no-cache-dir "vllm==0.11.0"

# Install verl dependencies
RUN PIP_CONSTRAINT="" pip install --no-cache-dir \
    accelerate \
    codetiming \
    liger-kernel \
    peft \
    pylatexenc \
    pybind11 \
    "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
    torchdata

# Install ALFWorld for game environments
RUN PIP_CONSTRAINT="" pip install --no-cache-dir alfworld

# Install wandb for experiment tracking
RUN PIP_CONSTRAINT="" pip install --no-cache-dir wandb

# Install Diplomacy game engine and opponent inference dependencies
RUN PIP_CONSTRAINT="" pip install --no-cache-dir \
    diplomacy \
    "openai>=1.0.0"

# Install Celery for task queue
RUN PIP_CONSTRAINT="" pip install --no-cache-dir \
    "celery>=5.3.0" \
    "kombu>=5.3.0"

# Create directories
RUN mkdir -p /workspace/OpenTinker /logs && \
    ln -sf /logs /workspace/logs

# Set log directory
ENV LOG_DIR=/logs

# Copy entire OpenTinker source (build context is OpenTinker root)
COPY . /workspace/OpenTinker/

# Install verl and opentinker as editable packages
RUN cd /workspace/OpenTinker/verl && pip install -e . --no-deps && \
    cd /workspace/OpenTinker && pip install -e . --no-deps

# Download ALFWorld game assets
RUN alfworld-download

# Install hf-transfer for faster model downloads
RUN PIP_CONSTRAINT="" pip install --no-cache-dir hf-transfer

# Rebuild flash-attn for current PyTorch version (fixes ABI incompatibility)
RUN PIP_CONSTRAINT='' pip install flash-attn --no-build-isolation --force-reinstall --no-deps

# Apply vLLM patch for CUDA allocator compatibility
RUN python /workspace/OpenTinker/patch_vllm_allocator.py

# Set working directory to worker service
WORKDIR /workspace/OpenTinker/service/worker

# Make entrypoint script executable
RUN chmod +x /workspace/OpenTinker/service/worker/start_worker.sh

# Run worker with scheduler and environment server
# (Each worker gets its own H100 GPU allocation via Kubernetes)
CMD ["/workspace/OpenTinker/service/worker/start_worker.sh"]
